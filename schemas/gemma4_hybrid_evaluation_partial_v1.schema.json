{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moe-sae.invalid/schemas/gemma4_hybrid_evaluation_partial_v1.schema.json",
  "title": "Gemma 4 routed/shared hybrid cross-process evaluation partial",
  "description": "Self-hashed compact additive statistics emitted by one TPU evaluation host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partial_id",
    "panel",
    "condition",
    "seed",
    "checkpoint_target_tokens",
    "total_features",
    "hidden_dim",
    "training_receipt_sha256",
    "checkpoint_firing_mask_sha256",
    "chunk_ids",
    "sequence_ids",
    "sequence_position_bits_hex",
    "sequence_valid_tokens",
    "sequence_sst",
    "sequence_sse",
    "heldout_fired_bits_hex",
    "evaluation_bank_component_counts",
    "endpoint_sse",
    "routed_target_sum",
    "routed_target_squared_norm_sum",
    "shared_target_sum",
    "shared_target_squared_norm_sum",
    "tokens",
    "partial_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "gemma4-routed-shared-hybrid-evaluation-partial-v1"
    },
    "partial_id": {
      "type": "string",
      "minLength": 1
    },
    "panel": {
      "enum": [
        "sae",
        "transcoder"
      ]
    },
    "condition": {
      "enum": [
        "H",
        "R",
        "B",
        "F"
      ]
    },
    "seed": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "checkpoint_target_tokens": {
      "enum": [
        2000000,
        5000000,
        10000000
      ]
    },
    "total_features": {
      "enum": [
        8192,
        69632
      ]
    },
    "hidden_dim": {
      "type": "integer",
      "minimum": 1
    },
    "training_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_firing_mask_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "chunk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sequence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sequence_position_bits_hex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{256}$"
      }
    },
    "sequence_valid_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1024
      }
    },
    "sequence_sst": {
      "$ref": "#/$defs/nonnegativeNumbers"
    },
    "sequence_sse": {
      "$ref": "#/$defs/nonnegativeNumbers"
    },
    "heldout_fired_bits_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "evaluation_bank_component_counts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 128,
          "maxItems": 128,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "endpoint_sse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_ffn",
        "routed",
        "shared",
        "oracle_shared_full_ffn",
        "oracle_routed_full_ffn"
      ],
      "properties": {
        "full_ffn": {
          "type": "number",
          "minimum": 0
        },
        "routed": {
          "type": "number",
          "minimum": 0
        },
        "shared": {
          "type": "number",
          "minimum": 0
        },
        "oracle_shared_full_ffn": {
          "type": "number",
          "minimum": 0
        },
        "oracle_routed_full_ffn": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "routed_target_sum": {
      "$ref": "#/$defs/nullableNumbers"
    },
    "routed_target_squared_norm_sum": {
      "$ref": "#/$defs/nullableNonnegative"
    },
    "shared_target_sum": {
      "$ref": "#/$defs/nullableNumbers"
    },
    "shared_target_squared_norm_sum": {
      "$ref": "#/$defs/nullableNonnegative"
    },
    "tokens": {
      "type": "integer",
      "minimum": 1
    },
    "partial_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegativeNumbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "nullableNumbers": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "nullableNonnegative": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    }
  }
}
