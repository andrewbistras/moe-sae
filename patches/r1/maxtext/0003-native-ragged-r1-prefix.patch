+    if self.config.num_moe_emb_chunks > 0:
+      unsupported.append("num_moe_emb_chunks>0")
+    if self.config.num_moe_token_chunks != 1:
+      unsupported.append("num_moe_token_chunks!=1")
+    if self.quant is not None:
+      unsupported.append("quantization")
+    if unsupported:
+      raise ValueError(
+          "R1 direct router metadata does not support " + ", ".join(unsupported)
+      )
+
