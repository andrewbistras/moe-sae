+  ) -> tuple[jax.Array, jax.Array]:
+    """Return DeepSeek-R1's global IDs and scaled weights without dispatch.
+
+    The B128 prefix runtime keeps ``use_batch_split_schedule`` enabled only to
+    preserve the released checkpoint/storage layout.  Its execution path uses
+    this ordinary ``RoutedMoE`` module directly.  Router metadata is therefore
+    recomputed through the same gate and ``get_topk`` implementation, before
+    any expert-parallel remapping performed by sparse dispatch.
+    """
+
+    unsupported = []
+    if not self.config.model_name.startswith("deepseek3"):
+      unsupported.append("model_name")
+    if not self.config.float32_gate_logits:
+      unsupported.append("float32_gate_logits=False")
+    if not self.config.sparse_matmul:
+      unsupported.append("sparse_matmul=False")
+    if self.config.use_ring_of_experts:
