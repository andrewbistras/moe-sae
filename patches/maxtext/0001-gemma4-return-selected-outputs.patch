+  @staticmethod
+  def _linear_local_sort_indices(
+      all_shard_local_sizes: jax.Array,
+      buffer_size: int,
+  ) -> tuple[jax.Array, jax.Array]:
+    """Build the sender-major to expert-major permutation in O(buffer).
+
+    ``ragged_all_to_all`` lays out received rows by sender and, within each
+    sender, by local expert. GMM consumes those rows grouped first by local
+    expert and then by sender. The small traffic-count matrix therefore
+    defines the permutation exactly; sorting one repeated expert ID for every
+    row in the worst-case ragged buffer is unnecessary.
+
+    Counts are prefix-truncated to ``buffer_size`` to preserve the existing
+    deterministic finite-capacity behavior. The padded tail maps to itself.
+    """
+    sender_count, local_expert_count = all_shard_local_sizes.shape
+    pair_count = sender_count * local_expert_count
+    counts_sender_expert = all_shard_local_sizes.reshape(-1)
+
+    input_ends = jnp.minimum(jnp.cumsum(counts_sender_expert), buffer_size)
+    input_starts_with_end = jnp.concatenate(
+        [jnp.zeros((1,), dtype=input_ends.dtype), input_ends]
+    )
+    effective_counts_sender_expert = jnp.diff(input_starts_with_end)
+    effective_counts = effective_counts_sender_expert.reshape(
+        sender_count, local_expert_count
+    )
+    counts_expert_sender = jnp.transpose(effective_counts).reshape(-1)
+
+    input_starts = input_starts_with_end[:-1]
+    output_ends = jnp.cumsum(counts_expert_sender)
+    output_starts = jnp.concatenate(
+        [jnp.zeros((1,), dtype=output_ends.dtype), output_ends[:-1]]
+    )
+    valid_end = output_ends[-1]
+
+    output_pairs = jnp.repeat(
+        jnp.arange(pair_count, dtype=counts_sender_expert.dtype),
+        counts_expert_sender,
+        total_repeat_length=buffer_size,
+    )
+    output_positions = jnp.arange(
+        buffer_size, dtype=counts_sender_expert.dtype
+    )
+    within_pair = output_positions - output_starts[output_pairs]
+    output_experts = jnp.floor_divide(output_pairs, sender_count)
+    output_senders = jnp.mod(output_pairs, sender_count)
+    input_pairs = output_senders * local_expert_count + output_experts
+    sorted_indices = input_starts[input_pairs] + within_pair
+
+    valid = output_positions < valid_end
+    sorted_indices = jnp.where(valid, sorted_indices, output_positions)
+    sorted_expert_ids = jnp.where(
+        valid,
+        output_experts,
+        jnp.maximum(local_expert_count - 1, 0),
+    )
+    return sorted_indices, sorted_expert_ids
+
+  @staticmethod
+  def _invert_permutation(indices: jax.Array) -> jax.Array:
+    """Return an O(n) inverse for a one-dimensional permutation."""
+    positions = jnp.arange(indices.shape[0], dtype=indices.dtype)
+    return jnp.zeros_like(indices).at[indices].set(positions)
 
