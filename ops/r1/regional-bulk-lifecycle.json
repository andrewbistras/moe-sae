{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 1,
        "matchesPrefix": [
          "staging/",
          "tmp/",
          "uploads/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 10
      }
    }
  ]
}
